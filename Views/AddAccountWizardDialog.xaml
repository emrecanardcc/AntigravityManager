<Window x:Class="AntigravityManager.Views.AddAccountWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yeni Google Hesabı Bağla" 
        Height="460" Width="520"
        WindowStartupLocation="CenterOwner"
        Background="#181825"
        Foreground="#CDD6F4"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#BAC2DE"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Border Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Başlık -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#6366F1" CornerRadius="8" Width="36" Height="36" Margin="0,0,12,0">
                        <TextBlock Text="✨" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Yeni Google Hesabı Bağla" FontSize="18" FontWeight="Bold" Foreground="#FFFFFF"/>
                        <TextBlock Text="Antigravity ilk kurulum modunda açılacak ve girişiniz otomatik algılanacaktır." 
                                   Foreground="#A6ADC8" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Orta Kart / Adımlar -->
            <Border Grid.Row="1" Background="#1E1E2E" CornerRadius="12" Padding="20" BorderBrush="#313244" BorderThickness="1">
                <StackPanel VerticalAlignment="Center">
                    <!-- Başlangıç Durumu -->
                    <StackPanel x:Name="PnlInstructions" Visibility="Visible">
                        <TextBlock Text="📌 Nasıl Çalışır?" FontWeight="Bold" FontSize="14" Foreground="#89B4FA" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="1. '🚀 Girişi Başlat' butonuna tıklayın." Margin="0,0,0,6"/>
                        <TextBlock Text="2. Antigravity tertemiz bir oturumla (ilk kez kurulmuş gibi) açılacak." Margin="0,0,0,6"/>
                        <TextBlock Text="3. Açılan pencerede diğer Google hesabınızla 'Sign In' yapın." Margin="0,0,0,6"/>
                        <TextBlock Text="4. Giriş tamamlandığında sistem hesabınızı şifre sormadan otomatik kaydedecektir." 
                                   TextWrapping="Wrap" Foreground="#A6E3A1" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Bekleme Durumu (Giriş Yapılırken) -->
                    <StackPanel x:Name="PnlWaiting" Visibility="Collapsed" HorizontalAlignment="Center">
                        <TextBlock Text="⏳ Google Girişi Bekleniyor..." 
                                   FontWeight="Bold" FontSize="16" Foreground="#F9E2AF" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        
                        <TextBlock Text="Lütfen açılan Antigravity penceresinde yeni Google hesabınızla oturum açın." 
                                   TextWrapping="Wrap" TextAlignment="Center" Foreground="#BAC2DE" Margin="0,0,0,16"/>

                        <ProgressBar IsIndeterminate="True" Height="6" Width="260" 
                                     Background="#313244" Foreground="#6366F1" BorderThickness="0" Margin="0,0,0,14"/>

                        <TextBlock Text="Giriş algılandığında bu pencere otomatik olarak tamamlanacaktır..." 
                                   FontSize="11" Foreground="#6C7086" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Başarı Durumu -->
                    <StackPanel x:Name="PnlSuccess" Visibility="Collapsed" HorizontalAlignment="Center">
                        <TextBlock Text="🎉" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                        <TextBlock Text="Hesap Başarıyla Eklendi!" FontWeight="Bold" FontSize="16" Foreground="#A6E3A1" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock x:Name="TxtSuccessDetails" Text="İsim (email@gmail.com)" Foreground="#FFFFFF" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Alt Butonlar -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="BtnCancel" Content="İptal" Width="100" Height="40" Margin="0,0,12,0"
                        Background="#313244" Foreground="#CDD6F4" BorderThickness="0"
                        Cursor="Hand" Click="BtnCancel_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <Button x:Name="BtnStart" Content="🚀 Girişi Başlat" Width="140" Height="40"
                        Background="#6366F1" Foreground="#FFFFFF" FontWeight="Bold" BorderThickness="0"
                        Cursor="Hand" Click="BtnStart_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
